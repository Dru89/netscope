{
  "name": "netscope",
  "version": "4.0.0",
  "description": "A desktop app for viewing and exploring HAR files",
  "author": "Drew Hays <drew@hays.fm>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dru89/netscope"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "tauri build",
    "build:vite": "tsc && vite build",
    "tauri": "tauri",
    "release": "make release",
    "site:dev": "npm run dev --prefix site",
    "site:build": "npm run build --prefix site",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.8.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.2",
    "vite": "^5.4.21",
    "vitest": "^4.1.4"
  }
}

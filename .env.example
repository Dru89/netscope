# Signing, notarization, and publishing credentials.
#
# NOTE: nothing in this project loads a .env file. The Tauri CLI has no
# dotenv support, so copying this to .env will NOT make these take effect.
# This file is a checklist of the variables that matter and where they are
# used. To use them locally, export them in your shell or pass them inline:
#
#   TAURI_SIGNING_PRIVATE_KEY_PASSWORD="" npx tauri build
#
# In CI these are GitHub Actions secrets — see .github/workflows/release.yml.
#
# DO NOT commit real values.

# --- Updater signing (required for any local bundle) --------------------
#
# Without these, `tauri build` fails at the bundling step. To skip signing
# entirely for a local test build, use `npx tauri build --no-sign` instead
# of setting them. See docs/development.md.
#
# If this key is lost, already-shipped apps can never update again.
#
# Provide the key inline, or point at the file — not both:
TAURI_SIGNING_PRIVATE_KEY="dW50cnVzdGVkIGNvbW1lbnQ6..."
# TAURI_SIGNING_PRIVATE_KEY_PATH="/path/to/netscope.key"
#
# Must be SET even when the key has no password. Setting it to an empty
# string is not the same as leaving it unset — unset makes the CLI stop and
# wait on an interactive password prompt.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

# --- Apple notarization (macOS release builds) --------------------------
APPLE_ID="your-apple-id@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"
APPLE_TEAM_ID="XXXXXXXXXX"

# GitHub token for publishing releases (local builds only — CI uses GITHUB_TOKEN)
# Create at: https://github.com/settings/tokens
# Requires "repo" scope (or "contents: write" for fine-grained tokens)
GH_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# macOS signing certificate (GitHub Actions only)
# Export your Developer ID certificate as a .p12 file, then base64-encode it:
#   base64 -i certificate.p12 | pbcopy
# Store as the MAC_CERTIFICATE_BASE64 secret in GitHub Actions.
# MAC_CERTIFICATE_BASE64="..."
# MAC_CERTIFICATE_PASSWORD="the-password-you-set-when-exporting"

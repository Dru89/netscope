{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Netscope",
  "version": "4.0.0",
  "identifier": "dev.unremarkable.netscope",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Netscope",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": ["har"],
        "name": "HAR File",
        "description": "HTTP Archive File",
        "role": "Viewer"
      }
    ],
    "linux": {}
  }
}

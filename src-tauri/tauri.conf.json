{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Netscope",
  "version": "../package.json",
  "identifier": "dev.unremarkable.netscope",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:vite"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "fileAssociations": [
      {
        "ext": [
          "har"
        ],
        "name": "HAR File",
        "description": "HTTP Archive File",
        "role": "Viewer",
        "mimeType": "application/json"
      }
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "./netscope.desktop"
      },
      "appimage": {}
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCMjBGM0Q5MzRCNDZENDEKUldSQmJiUTAyZk1nUzZpOUVsSHhIdDJVeCs2bFljSklxa0Q5TkJ2dWlWRENXUlpiakNCdXgvWXgK",
      "endpoints": [
        "https://github.com/Dru89/netscope/releases/latest/download/latest.json"
      ]
    }
  }
}
